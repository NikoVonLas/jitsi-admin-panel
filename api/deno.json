{
  "fmt": {
    "exclude": ["cov_profile/", "coverage/"]
  },
  "lint": {
    "exclude": ["cov_profile/", "coverage/"]
  },
  "imports": {
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@emrahcom/jwt": "jsr:@emrahcom/jwt@^0.4.10",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "@std/uuid": "jsr:@std/uuid@^1.1.1",
    "nodemailer": "npm:nodemailer@^8.0.11",
    "favicons": "npm:favicons@^7.3.1"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "test": "deno test --allow-all --env=test/env.test --coverage=cov_profile test/",
    "test:coverage": "deno task test && mkdir -p coverage && deno coverage cov_profile --lcov --output=coverage/lcov.info",
    "migrate:test": "deno run --allow-all --env=test/env.test test/migrate.ts"
  }
}
