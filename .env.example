# PostgreSQL connection (DB_PASSWD is required)
DB_NAME=jitsi
DB_USER=jitsi
DB_PASSWD=
DB_PORT=5432
DB_POOL_SIZE=8

# API secret key (required, at least 32 characters; e.g. `openssl rand -hex 32`)
API_SECRET=

# Hostname where the app is running (without protocol, e.g. example.com)
# Production:  APP_FQDN=example.com  — Caddy auto-issues a Let's Encrypt cert
# Local HTTPS: APP_FQDN=localhost    — Caddy uses its internal CA (run `docker compose exec web caddy trust` once)
# Local HTTP:  APP_FQDN=localhost with APP_SCHEME=http and SESSION_COOKIE_SECURE=false
APP_FQDN=localhost

# Public scheme used in generated links and OIDC redirect URIs
APP_SCHEME=https

# Secure flag for authentication cookies (defaults to true with APP_SCHEME=https)
SESSION_COOKIE_SECURE=true


# Mailer configuration
MAILER_HOST=
MAILER_PORT=465
MAILER_SECURE=true
MAILER_USER=
MAILER_PASS=
MAILER_FROM=

# Auth: email/password login (true by default)
AUTH_LOCAL=true

# Optional first OIDC provider bootstrap (useful with AUTH_LOCAL=false)
OIDC_PROVIDER_NAME=Keycloak
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# Keycloak realm role that grants panel superadmin access
SUPERADMIN_ROLE=jitsi-superadmin

# Allow self-signed TLS certificates (development only)
ALLOW_UNSECURE_CERT=false

# Auth session lifetime in seconds
API_TIMEOUT=86400

# UI language (en or ru)
LANG_UI=en
